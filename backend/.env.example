NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smarttracker
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JSON_BODY_LIMIT=1mb
# Exact browser origins allowed to call the API; comma-separated, no trailing paths.
# Production must replace these with the deployed web origins. Never use *.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_MINUTES=15
PRIMARY_ADMIN_CODE_MINUTES=30
ADMIN_INVITATION_MINUTES=1440
BCRYPT_ROUNDS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
