# Platform-specific URLs take precedence over EXPO_PUBLIC_API_URL.
# Web default: http://localhost:5000/api/v1 (backend CORS must allow the Expo web origin).
# Android emulator default: http://10.0.2.2:5000/api/v1 (10.0.2.2 reaches the host machine).
# Physical Android: set this to the development computer's LAN IP; do not use localhost.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_URL_WEB=http://localhost:5000/api/v1
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:5000/api/v1
